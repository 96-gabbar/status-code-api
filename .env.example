# Local development defaults. Copy to .env only when overrides are needed.
STATUS_CODE_API_ENVIRONMENT=development
STATUS_CODE_API_REPOSITORY_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://status_code_api:status_code_api@localhost:5432/status_code_api
STATUS_CODE_API_LOG_LEVEL=INFO
STATUS_CODE_API_SQL_ECHO=false
STATUS_CODE_API_PORTFOLIO_VALIDATION_ENABLED=false
STATUS_CODE_API_PORTFOLIO_SERVICE_URL=http://localhost:8001

PORTFOLIO_API_ENVIRONMENT=development
PORTFOLIO_API_REPOSITORY_BACKEND=postgres
PORTFOLIO_DATABASE_URL=postgresql+psycopg://portfolio_api:portfolio_api@localhost:55433/portfolio_service
PORTFOLIO_API_LOG_LEVEL=INFO
PORTFOLIO_API_SQL_ECHO=false
